# Variables de MANI-.NET (Dispatch). Copiar a .env y completar; .env nunca se sube.
# En QA/PROD los valores viven en /opt/mani/.env.<ambiente> de la VM (ADR-0031 §5).

# URL base de Core (TEC-06, SCRUM-1453). Obligatoria: sin ella Dispatch no arranca.
# Respaldo: ServiceUrls__CoreService. Dentro de la red de compose: http://core-service:3000
CORE_SERVICE_URL=http://core-service:3000

# URL base de Rules (orden de los elegibles, SCRUM-1462). Sin ella eligible-allies responde 503.
RULES_SERVICE_URL=http://rules-service:8080

# Validación del JWT de Supabase (TEC-07): JWKS del proyecto y, para tokens HS256 de desarrollo, el secreto.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# PostgreSQL con el rol de servicio de Dispatch, sin BYPASSRLS (ADR-0032).
# Formato Npgsql: Host=<host>;Database=postgres;Username=mani_dispatch_svc;Password=<clave>;SSL Mode=Require
ConnectionStrings__DefaultConnection=

ASPNETCORE_ENVIRONMENT=Development
